# Copy to .env and provide local values. Never commit credentials.
MYSQL_DATABASE=zhiyan
MYSQL_USER=zhiyan
MYSQL_PASSWORD=replace_with_local_password
MYSQL_ROOT_PASSWORD=replace_with_different_local_password
DATABASE_URL=mysql+pymysql://zhiyan:replace_with_local_password@127.0.0.1:3307/zhiyan?charset=utf8mb4

# Set true when served over HTTPS.
SECURE_COOKIES=false
PUBLIC_ORIGIN=

# Optional PDF upload limit in bytes (default 50 MiB).
PDF_MAX_BYTES=52428800

# Generate locally with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_ENCRYPTION_KEY=

# Per-user accepted AI tasks in a rolling window; enforced in MySQL.
AI_RATE_LIMIT_COUNT=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
